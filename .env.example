APP_ENV=production
DATABASE_URL=sqlite:///./data/identity.db
APP_MASTER_KEY=
SESSION_SECRET=
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_MAX_PAGES=3
AMAP_REQUEST_INTERVAL_SECONDS=0.3
AMAP_RETRY_LIMIT=3
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REQUEST_INTERVAL_SECONDS=0.4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟推理接入点 ID，格式为 ep-xxxxxxxx。
DOUBAO_MODEL=
# 低成本中转只负责候选公司发现；三项同时配置后优先于上面的官方方舟配置。
DOUBAO_RELAY_API_KEY=
DOUBAO_RELAY_BASE_URL=
DOUBAO_RELAY_MODEL=
DOUBAO_WEB_ENABLED=false
DOUBAO_WEB_PROFILE_DIR=./data/doubao-browser-profile
DOUBAO_WEB_CHAT_URL=https://www.doubao.com/chat/
DOUBAO_WEB_CDP_HOST=127.0.0.1
DOUBAO_WEB_CDP_PORT=9333
DOUBAO_WEB_BROWSER_EXECUTABLE=
DOUBAO_WEB_REQUEST_TIMEOUT_SECONDS=180
# 豆包网页节流：每次查询间隔 45～90 秒，每 8～12 次冷却 45～60 分钟。
DOUBAO_WEB_MIN_INTERVAL_SECONDS=45
DOUBAO_WEB_MAX_INTERVAL_SECONDS=90
DOUBAO_WEB_BATCH_MIN_SIZE=8
DOUBAO_WEB_BATCH_MAX_SIZE=12
DOUBAO_WEB_COOLDOWN_MIN_SECONDS=2700
DOUBAO_WEB_COOLDOWN_MAX_SECONDS=3600
DOUBAO_WEB_ATTENTION_POLL_SECONDS=90
DOUBAO_WEB_READY_CONFIRMATIONS=3
COLLECTION_MAX_CONCURRENT_TASKS=2
LEGACY_COLLECTION_OWNER_ID=
ERP_AUTO_PUSH=false
ERP_DELIVERY_URL=
ERP_DELIVERY_TIMEOUT_SECONDS=30
